{
  "manifest_version": 3,
  "name": "Sonora Context",
  "version": "1.0.0",
  "description": "Shares limited, privacy-filtered browser context with the local Sonora app.",
  "permissions": ["nativeMessaging"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
